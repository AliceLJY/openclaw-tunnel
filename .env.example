# === task-api (runs in Docker) ===
WORKER_TOKEN=           # Required. Shared auth token (min 16 chars). Generated by setup.sh.
PORT=3456               # task-api listen port
CALLBACK_BOT_TOKEN=     # Required. Discord bot token (or platform equivalent) for result delivery.
CALLBACK_API_BASE_URL=https://discord.com/api/v10  # Change for non-Discord platforms.
CALLBACK_CHANNEL=       # Optional fallback channel/thread ID when a task has no callbackChannel.

# === runner (runs on host) ===
WORKER_URL=http://localhost:3456   # task-api URL from host's perspective
CLAUDE_PATH=claude                 # Claude Code CLI binary path
CODEX_PATH=codex                   # Codex CLI binary path
GEMINI_PATH=gemini                 # Gemini CLI binary path
CC_TIMEOUT=1200000                 # Claude Code execution timeout in ms (default: 20 min)
CC_MODELS=                         # Optional comma list. Empty = use Claude Code default. Example: claude-sonnet-4-5,default
RUNNER_SESSION_CACHE_FILE=         # Optional. Empty = OS temp dir/openclaw-runner-session-cache.json
CC_LOG_PATH=                       # Optional. Empty = OS temp dir/cc-live.log
WORKER_DIRECT_CALLBACK=false       # Legacy opt-in: let runner call callback API directly.
